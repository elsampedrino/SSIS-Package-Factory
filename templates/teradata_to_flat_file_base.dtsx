                <property dataType="System.String" description="The name of the table to be fetched." expressionType="Notify" name="TableName" />
                <property dataType="System.String" description="The SQL command to be executed." expressionType="Notify" name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
    COALESCE(TO_CHAR(Fec_Proceso, 'YYYYMMDD'), '00000000') AS Fec_Proceso_PIC,
    LPAD(TRIM(COALESCE(Id_d_Cliente, 0)), 20, '0') AS Id_d_Cliente_PIC,
    RPAD(SUBSTR(COALESCE(Nom_Cliente, ''), 1, 200), 200, ' ') AS Nom_Cliente_PIC,
    RPAD(SUBSTR(COALESCE(Num_Documento, ''), 1, 20), 20, ' ') AS Num_Documento_PIC,
    LPAD(TRIM(COALESCE(Num_Cuenta_Credito_VISA, '')), 20, '0') AS Num_Cuenta_Credito_VISA_PIC,
    LPAD(TRIM(COALESCE(Num_Cuenta_Credito_MASTER, '')), 20, '0') AS Num_Cuenta_Credito_MASTER_PIC,
    RPAD(SUBSTR(COALESCE(Num_Identif_Tributaria, ''), 1, 20), 20, ' ') AS Num_Identif_Tributaria_PIC,
    RPAD(SUBSTR(COALESCE(Num_Tarjeta, ''), 1, 16), 16, ' ') AS Num_Tarjeta_PIC,
    RPAD(SUBSTR(COALESCE(Cod_localizacion_Domicilio, ''), 1, 20), 20, ' ') AS Cod_localizacion_Domicilio_PIC,
    RPAD(SUBSTR(COALESCE(Cod_Tipo_Domicilio, ''), 1, 10), 10, ' ') AS Cod_Tipo_Domicilio_PIC,
    RPAD(SUBSTR(COALESCE(Desc_Tipo_Domicilio, ''), 1, 100), 100, ' ') AS Desc_Tipo_Domicilio_PIC,
    RPAD(SUBSTR(COALESCE(Nom_Domicilio, ''), 1, 100), 100, ' ') AS Nom_Domicilio_PIC,
    LPAD(TRIM(COALESCE(Num_Domicilio, '')), 10, '0') AS Num_Domicilio_PIC,
    RPAD(SUBSTR(COALESCE(Num_Piso, ''), 1, 10), 10, ' ') AS Num_Piso_PIC,
    RPAD(SUBSTR(COALESCE(Nom_Departamento, ''), 1, 10), 10, ' ') AS Nom_Departamento_PIC,
    RPAD(SUBSTR(COALESCE(Num_Bloque, ''), 1, 10), 10, ' ') AS Num_Bloque_PIC,
    RPAD(SUBSTR(COALESCE(Cod_Postal, ''), 1, 10), 10, ' ') AS Cod_Postal_PIC,
    RPAD(SUBSTR(COALESCE(Nom_Ciudad, ''), 1, 100), 100, ' ') AS Nom_Ciudad_PIC,
    RPAD(SUBSTR(COALESCE(Cod_Provincia, ''), 1, 10), 10, ' ') AS Cod_Provincia_PIC,
    RPAD(SUBSTR(COALESCE(Desc_Provincia, ''), 1, 100), 100, ' ') AS Desc_Provincia_PIC,
    RPAD(SUBSTR(COALESCE(Cod_Pais, ''), 1, 10), 10, ' ') AS Cod_Pais_PIC,
    RPAD(SUBSTR(COALESCE(Desc_Pais, ''), 1, 100), 100, ' ') AS Desc_Pais_PIC,
    COALESCE(TO_CHAR(Fec_Desde_Domicilio, 'YYYYMMDD'), '00000000') AS Fec_Desde_Domicilio_PIC,
    COALESCE(TO_CHAR(Fec_Hasta_Domicilio, 'YYYYMMDD'), '00000000') AS Fec_Hasta_Domicilio_PIC,
    RPAD(SUBSTR(COALESCE(Cod_Localizacion_Email, ''), 1, 20), 20, ' ') AS Cod_Localizacion_Email_PIC,
    RPAD(SUBSTR(COALESCE(Txt_Email, ''), 1, 100), 100, ' ') AS Txt_Email_PIC,
    RPAD(SUBSTR(COALESCE(Cod_Tipo_Email, ''), 1, 10), 10, ' ') AS Cod_Tipo_Email_PIC,
    COALESCE(TO_CHAR(Fec_Alta_Email, 'YYYYMMDD'), '00000000') AS Fec_Alta_Email_PIC,
    COALESCE(TO_CHAR(Fec_Baja_Email, 'YYYYMMDD'), '00000000') AS Fec_Baja_Email_PIC,
    COALESCE(TO_CHAR(Fec_Desde_Email, 'YYYYMMDD'), '00000000') AS Fec_Desde_Email_PIC,
    COALESCE(TO_CHAR(Fec_Hasta_Email, 'YYYYMMDD'), '00000000') AS Fec_Hasta_Email_PIC,
    RPAD(SUBSTR(COALESCE(Cod_Localizacion_Telefono, ''), 1, 20), 20, ' ') AS Cod_Localizacion_Telefono_PIC,
    RPAD(SUBSTR(COALESCE(Num_Cod_Area, ''), 1, 10), 10, ' ') AS Num_Cod_Area_PIC,
    RPAD(SUBSTR(COALESCE(Num_Telefono, ''), 1, 20), 20, ' ') AS Num_Telefono_PIC,
    RPAD(SUBSTR(COALESCE(TRIM(OREPLACE(OREPLACE(Txt_Nota_Telefono, CHR(13), ' '),CHR(10), ' ')),''),1,100),100,' ') AS Txt_Nota_Telefono_PIC,
    COALESCE(TO_CHAR(Fec_Alta_Telefono, 'YYYYMMDD'), '00000000') AS Fec_Alta_Telefono_PIC,
    COALESCE(TO_CHAR(Fec_Baja_Telefono, 'YYYYMMDD'), '00000000') AS Fec_Baja_Telefono_PIC,
    COALESCE(TO_CHAR(Fec_Desde_Telefono, 'YYYYMMDD'), '00000000') AS Fec_Desde_Telefono_PIC,
    COALESCE(TO_CHAR(Fec_Hasta_Telefono, 'YYYYMMDD'), '00000000') AS Fec_Hasta_Telefono_PIC
FROM d_datos_contacto_PROCESADORAS
WHERE FEC_DESDE_DOMICILIO BETWEEN DATE-10 AND DATE-1
  OR  FEC_ALTA_EMAIL BETWEEN DATE-10 AND DATE-1
  OR  FEC_DESDE_EMAIL BETWEEN DATE-10 AND DATE-1
  OR  FEC_ALTA_TELEFONO BETWEEN DATE-10 AND DATE-1
  OR  FEC_DESDE_TELEFONO BETWEEN DATE-10 AND DATE-1;</property>
