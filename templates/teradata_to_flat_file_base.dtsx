            <component refId="Package\Genera archivo en local\Teradata Source" componentClassID="Microsoft.SSISTeradataSrc" contactInfo="Teradata Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;1" description="Teradata Source" name="Teradata Source" usesDispositions="true" version="1">
